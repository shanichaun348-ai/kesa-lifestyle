# Copy to deploy/.env.production on the server and fill in real values.
# Loaded by docker compose (runtime) and mounted as a build secret (build time).
# NEVER commit deploy/.env.production.

# ── Where the site lives ──────────────────────────────────────────────────────
SITE_DOMAIN=kesa.dev-build.in
NEXT_PUBLIC_SITE_URL=https://kesa.dev-build.in
# Email Let's Encrypt uses for certificate notices
ACME_EMAIL=hello@kesalifestyle.com

# ── Supabase (same project as today) ─────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Admin login ───────────────────────────────────────────────────────────────
ADMIN_SESSION_SECRET=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD_HASH=

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
ORDER_NOTIFY_EMAIL=

# ── WhatsApp (optional until Meta approves the templates) ─────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ORDER_TEMPLATE=order_confirmed
WHATSAPP_COD_ORDER_TEMPLATE=order_confirmed_cod
WHATSAPP_SHIPPED_TEMPLATE=order_shipped
WHATSAPP_DELIVERED_TEMPLATE=order_delivered
WHATSAPP_CART_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ── Scheduled jobs (the scheduler container sends this as a Bearer token) ─────
CRON_SECRET=

# ── Analytics (optional) ──────────────────────────────────────────────────────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
