# Public (safe to expose to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin auth ────────────────────────────────────────────────────────────────
# HMAC-SHA256 session signing key — at least 32 characters. Generate with:
#   node -e "require('crypto').randomBytes(32).toString('hex')|console.log"
ADMIN_SESSION_SECRET=change-me-to-a-random-32-char-secret

# Bootstrap admin credentials (used until Supabase admin_users table is live, D10).
# Generate the hash with: node scripts/hash-password.mjs
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_NAME=Admin
ADMIN_BOOTSTRAP_PASSWORD_HASH=

# Optional: restrict admin to a dedicated hostname in production (ADR-31).
# Leave unset to allow localhost/dev access via /admin/.
# ADMIN_HOST=admin.kesalifestyle.com

# ── Supabase (required for production checkout + orders) ─────────────────────
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=
# Service role secret key (server-only — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
# Public keys (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Razorpay (required for production payments) ───────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Transactional email (Resend) ──────────────────────────────────────────────
# Order confirmations are skipped (and logged) when these are unset.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Kesa Lifestyle <orders@kesalifestyle.com>"
EMAIL_FROM=
# Optional: internal inbox that gets a copy of every new paid order
ORDER_NOTIFY_EMAIL=

# ── WhatsApp order confirmations (Meta WhatsApp Business Platform) ────────────
# Skipped (and logged) when unset. See docs/PRODUCTION_CONFIGURATION.md → WhatsApp.
# Permanent system-user token from Meta Business Settings with whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=
# "Phone number ID" of the sender number in WhatsApp Manager (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# Approved Utility template with 4 body parameters: first name, order ref, total paid, items
WHATSAPP_ORDER_TEMPLATE=order_confirmed
# Same 4 parameters, worded for cash on delivery ("…pay {{3}} when it arrives")
WHATSAPP_COD_ORDER_TEMPLATE=order_confirmed_cod
# Shipped: 4 body parameters — first name, order ref, courier, tracking number (+ link if any). Suggested body:
#   "Hi {{1}}, your Kesa Lifestyle order {{2}} is on its way with {{3}}. Tracking: {{4}}. Delivery usually takes 3–7 days."
WHATSAPP_SHIPPED_TEMPLATE=order_shipped
# Delivered: 2 body parameters — first name, order ref. Suggested body:
#   "Hi {{1}}, your Kesa Lifestyle order {{2}} has been delivered. We'd love to hear how it looks — reply to this message or review it on our site."
WHATSAPP_DELIVERED_TEMPLATE=order_delivered
# Bag reminder (Marketing category, opt-in): 3 body parameters — items, subtotal, resume link. Leave unset for email-only reminders. Suggested body:
#   "You left {{1}} in your Kesa Lifestyle bag ({{2}}). It's saved for a few days — finish your order here: {{3}}. Reply STOP to opt out."
WHATSAPP_CART_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ── Scheduled jobs ────────────────────────────────────────────────────────────
# Bearer token the job routes under /api/jobs/* require. Set the same value in
# Vercel (Cron sends it automatically) and as the GitHub Actions secret
# CRON_SECRET (hourly abandoned-cart reminders). At least 16 characters:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Server-only secrets are added per phase (Supabase, Razorpay, Shiprocket, Resend).
# Never commit real values. See docs/11_SECURITY_REQUIREMENTS.md §9.
