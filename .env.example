# ─────────────────────────────────────────────────────────────────────────────
# Kesa Lifestyle — environment variables
#
# Copy to .env.local for development. Never commit real values. Production
# values live in Vercel environment variables (docs/11 §9).
#
# Public values (NEXT_PUBLIC_*) are inlined into the browser bundle: only put
# things here that are safe to be seen by anyone.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public ───────────────────────────────────────────────────────────────────
# Canonical site origin (used for canonical URLs, sitemaps, structured data).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase project URL and anon (publishable) key. The anon key is safe to
# expose: it only grants what RLS policies allow, and RLS denies `anon` everything.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server only ──────────────────────────────────────────────────────────────
# Postgres connection for the application role `kesa_app` through the Supabase
# pooler in TRANSACTION mode (port 6543 on hosted; 54322 on `supabase start`).
# Format: postgresql://kesa_app:<password>@<host>:6543/postgres
DATABASE_URL=
# Direct (session) connection for migrations and seeds only (port 5432 hosted).
DATABASE_DIRECT_URL=
# Service-role key. Server only. Used for Storage admin and Auth admin calls,
# never for data queries. Must never appear in client code (tests enforce this).
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for cron-invoked job routes (/api/jobs/*). Generate: openssl rand -hex 32
CRON_SECRET=
# Allow `pnpm db:seed` against a non-local database (staging only). Leave unset.
# ALLOW_SEED=1

# ── Added in later phases (documented now so nothing is surprising) ──────────
# RAZORPAY_KEY_ID=            # public key id (also exposed as NEXT_PUBLIC_RAZORPAY_KEY_ID)
# RAZORPAY_KEY_SECRET=        # server only
# RAZORPAY_WEBHOOK_SECRET=    # server only
# SHIPROCKET_EMAIL= / SHIPROCKET_PASSWORD=   # server only
# RESEND_API_KEY=             # server only
# SENTRY_DSN= / NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# GA_API_SECRET=              # server only (Measurement Protocol)
