# Public (safe to expose to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin auth ────────────────────────────────────────────────────────────────
# HMAC-SHA256 session signing key — at least 32 characters. Generate with:
#   node -e "require('crypto').randomBytes(32).toString('hex')|console.log"
ADMIN_SESSION_SECRET=change-me-to-a-random-32-char-secret

# Bootstrap admin credentials (used until Supabase admin_users table is live, D10).
# Generate the hash with: node scripts/hash-password.mjs
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_NAME=Admin
ADMIN_BOOTSTRAP_PASSWORD_HASH=

# Optional: restrict admin to a dedicated hostname in production (ADR-31).
# Leave unset to allow localhost/dev access via /admin/.
# ADMIN_HOST=admin.kesalifestyle.com

# ── Supabase (required for production checkout + orders) ─────────────────────
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=
# Service role secret key (server-only — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
# Public keys (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Razorpay (required for production payments) ───────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Phase 2: Resend (add when D14 is resolved) ───────────────────────────────
# RESEND_API_KEY=
# EMAIL_FROM=

# Server-only secrets are added per phase (Supabase, Razorpay, Shiprocket, Resend).
# Never commit real values. See docs/11_SECURITY_REQUIREMENTS.md §9.
